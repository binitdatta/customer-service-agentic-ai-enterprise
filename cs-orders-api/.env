# -----------------------------------------------------------------------------
# Flask / App
# -----------------------------------------------------------------------------
FLASK_ENV=development
APP_NAME=cs-orders-api
APP_HOST=0.0.0.0
APP_PORT=6061
FLASK_SECRET_KEY=dev-change-me-please
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# MySQL
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=order_ops_ai
DB_USER=root
DB_PASSWORD=localroot

# Optional SQLAlchemy tuning
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECS=1800

# -----------------------------------------------------------------------------
# Keycloak (Resource Server)
# -----------------------------------------------------------------------------
KC_ISSUER=http://localhost:8080/realms/cs-triage
KC_JWKS_URL=http://localhost:8080/realms/cs-triage/protocol/openid-connect/certs
KC_AUDIENCE=cs-orders-api

# Enforce roles (recommended for your current setup)
KC_REQUIRED_SCOPE=
KC_REQUIRED_ROLE=order_read
KC_ROLE_MODE=either
KC_CLOCK_SKEW_SECONDS=30

# -----------------------------------------------------------------------------
# CORS (enable only if browser clients call this API directly)
# -----------------------------------------------------------------------------
CORS_ENABLED=false
CORS_ALLOW_ORIGINS=http://localhost:4200,http://localhost:6060
CORS_ALLOW_HEADERS=Authorization,Content-Type
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
